# Server
PORT=3000

# MongoDB: leave empty to run in clearly-labelled in-memory development mode
MONGODB_URI=mongodb://127.0.0.1:27017/cloud_storage_optimizer

# Storage mode: local (default) or s3
STORAGE_MODE=local
LOCAL_STORAGE_DIR=storage

# AWS S3 (required only when STORAGE_MODE=s3)
AWS_REGION=ap-south-1
AWS_S3_BUCKET=your-unique-bucket-name
# Use AWS CLI/default credential chain or set these locally. Never commit them.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Lifecycle rules (days since last access)
WARM_AFTER_DAYS=30
COLD_AFTER_DAYS=90
ARCHIVE_AFTER_DAYS=180

# Display-only cost conversion for the dashboard. Update this before your demo if needed.
# This is a documented assumption, not a live foreign-exchange feed.
USD_TO_INR=86
